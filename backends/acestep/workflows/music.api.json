{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "ACE-Step 1.5 turbo, all in one file (DiT + both text encoders + VAE)" },
    "inputs": { "ckpt_name": "ace_step_1.5_turbo_aio.safetensors" }
  },
  "2": {
    "class_type": "ModelSamplingAuraFlow",
    "_meta": { "title": "shift 3 — the value ComfyUI's own ACE-Step 1.5 templates use" },
    "inputs": { "model": ["1", 0], "shift": 3 }
  },
  "5": {
    "class_type": "TextEncodeAceStepAudio1.5",
    "_meta": { "title": "the plan: PATCH:tags PATCH:lyrics PATCH:plan_seed=seed PATCH:bpm PATCH:duration PATCH:timesignature PATCH:keyscale PATCH:generate_audio_codes" },
    "inputs": {
      "clip": ["1", 1],
      "tags": "",
      "lyrics": "[instrumental]",
      "seed": 0,
      "bpm": 120,
      "duration": 120.0,
      "timesignature": "4",
      "language": "en",
      "keyscale": "C major",
      "generate_audio_codes": true,
      "cfg_scale": 2.0,
      "temperature": 0.85,
      "top_p": 0.9,
      "top_k": 0,
      "min_p": 0.0
    }
  },
  "6": {
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "the negative side is the positive zeroed, as ACE-Step 1.5 is conditioned" },
    "inputs": { "conditioning": ["5", 0] }
  },
  "10": {
    "class_type": "EmptyAceStep1.5LatentAudio",
    "_meta": { "title": "PATCH:seconds — the latent's own length, which must agree with the plan's duration" },
    "inputs": { "seconds": 120.0, "batch_size": 1 }
  },
  "11": {
    "class_type": "KSampler",
    "_meta": { "title": "PATCH:seed — 8 steps at cfg 1.0, euler/simple, is turbo's own register" },
    "inputs": {
      "model": ["2", 0],
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["10", 0],
      "denoise": 1.0
    }
  },
  "12": {
    "class_type": "VAEDecodeAudio",
    "_meta": { "title": "latent to audio" },
    "inputs": { "samples": ["11", 0], "vae": ["1", 2] }
  },
  "14": {
    "class_type": "AudioAdjustVolume",
    "_meta": { "title": "PATCH:gain_db — ACE-Step 1.5 turbo normalises to peak, so the record states the gain it was rendered at" },
    "inputs": { "audio": ["12", 0], "volume": -3 }
  },
  "13": {
    "class_type": "SaveAudio",
    "_meta": { "title": "PATCH:filename_prefix — SaveAudio writes FLAC; the client transcodes to what --out asked for" },
    "inputs": { "audio": ["14", 0], "filename_prefix": "audio/forge" }
  }
}
