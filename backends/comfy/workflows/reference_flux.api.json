{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "FLUX.1-schnell fp8 all-in-one (model + clip + vae)" },
    "inputs": { "ckpt_name": "flux1-schnell-fp8.safetensors" }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "PATCH:prompt \u2014 style_prefix + character description" },
    "inputs": { "text": "", "clip": ["1", 1] }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "PATCH:negative_prompt \u2014 schnell samples at cfg 1.0, so it is inert" },
    "inputs": { "text": "", "clip": ["1", 1] }
  },
  "7": {
    "class_type": "LoadImage",
    "_meta": { "title": "PATCH:image \u2014 the pose, uploaded to ComfyUI's input dir" },
    "inputs": { "image": "forge_tpose_pose.png" }
  },
  "8": {
    "class_type": "ControlNetLoader",
    "_meta": { "title": "Shakker-Labs FLUX.1-dev ControlNet-Union-Pro-2.0 — NON-COMMERCIAL, trained on dev, applied off-base to schnell" },
    "inputs": { "control_net_name": "FLUX.1-dev-ControlNet-Union-Pro-2.0.safetensors" }
  },
  "9": {
    "class_type": "ControlNetApplyAdvanced",
    "_meta": { "title": "pose conditioning; PATCH:strength PATCH:start_percent PATCH:end_percent" },
    "inputs": {
      "positive": ["5", 0],
      "negative": ["6", 0],
      "control_net": ["8", 0],
      "image": ["7", 0],
      "strength": 0.85,
      "start_percent": 0.0,
      "end_percent": 0.85,
      "vae": ["1", 2]
    }
  },
  "10": {
    "class_type": "EmptySD3LatentImage",
    "_meta": { "title": "PATCH:width PATCH:height" },
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "11": {
    "class_type": "KSampler",
    "_meta": { "title": "PATCH:seed \u2014 steps 4 / cfg 1.0 is schnell's own register" },
    "inputs": {
      "model": ["1", 0],
      "seed": 0,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["9", 0],
      "negative": ["9", 1],
      "latent_image": ["10", 0],
      "denoise": 1.0
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "_meta": { "title": "decode" },
    "inputs": { "samples": ["11", 0], "vae": ["1", 2] }
  },
  "13": {
    "class_type": "SaveImage",
    "_meta": { "title": "PATCH:filename_prefix" },
    "inputs": { "images": ["12", 0], "filename_prefix": "forge/reference_flux" }
  }
}
