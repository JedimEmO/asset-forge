{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Qwen-Image fp8 diffusion model" },
    "inputs": { "unet_name": "qwen_image_fp8_e4m3fn.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "ModelSamplingAuraFlow",
    "_meta": { "title": "shift (ComfyUI's documented Qwen-Image value)" },
    "inputs": { "model": ["1", 0], "shift": 3.1 }
  },
  "3": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Qwen2.5-VL 7B text encoder" },
    "inputs": { "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image" }
  },
  "4": {
    "class_type": "VAELoader",
    "_meta": { "title": "Qwen-Image VAE" },
    "inputs": { "vae_name": "qwen_image_vae.safetensors" }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "PATCH prompt = style_prefix + character description" },
    "inputs": { "text": "", "clip": ["3", 0] }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "PATCH negative_prompt" },
    "inputs": { "text": "", "clip": ["3", 0] }
  },
  "7": {
    "class_type": "LoadImage",
    "_meta": { "title": "PATCH pose_image (uploaded to ComfyUI's input dir)" },
    "inputs": { "image": "forge_tpose_pose.png" }
  },
  "8": {
    "class_type": "ControlNetLoader",
    "_meta": { "title": "InstantX Qwen-Image ControlNet-Union (Apache-2.0, on-base)" },
    "inputs": { "control_net_name": "Qwen-Image-InstantX-ControlNet-Union.safetensors" }
  },
  "9": {
    "class_type": "ControlNetApplyAdvanced",
    "_meta": { "title": "pose conditioning; PATCH strength/start_percent/end_percent" },
    "inputs": {
      "positive": ["5", 0],
      "negative": ["6", 0],
      "control_net": ["8", 0],
      "image": ["7", 0],
      "strength": 0.85,
      "start_percent": 0.0,
      "end_percent": 0.85,
      "vae": ["4", 0]
    }
  },
  "10": {
    "class_type": "EmptySD3LatentImage",
    "_meta": { "title": "PATCH width/height" },
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "11": {
    "class_type": "KSampler",
    "_meta": { "title": "PATCH seed" },
    "inputs": {
      "model": ["2", 0],
      "seed": 0,
      "steps": 20,
      "cfg": 2.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["9", 0],
      "negative": ["9", 1],
      "latent_image": ["10", 0],
      "denoise": 1.0
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "_meta": { "title": "decode" },
    "inputs": { "samples": ["11", 0], "vae": ["4", 0] }
  },
  "13": {
    "class_type": "SaveImage",
    "_meta": { "title": "PATCH filename_prefix" },
    "inputs": { "images": ["12", 0], "filename_prefix": "forge/reference_qwen" }
  }
}
